# Local development defaults. Replace passwords before exposing services beyond localhost.
EL_ES_URL=http://127.0.0.1:9200
EL_ES_USER=elastic
EL_ES_PASSWORD=change-me
EL_QDRANT_URL=http://127.0.0.1:6333
EL_QDRANT_API_KEY=change-me
EL_NEO4J_URI=bolt://127.0.0.1:7687
EL_NEO4J_USER=neo4j
EL_NEO4J_PASSWORD=change-me-too

# Keep the embedding dimension in sync with the configured Qdrant collection.
EL_EMBED_MODEL=BAAI/bge-small-en-v1.5
EL_EMBED_DIM=384
EL_RERANK_MODEL=BAAI/bge-reranker-base
EL_LLM_BASE_URL=http://127.0.0.1:11434/v1
EL_LLM_MODEL=gemma:2b

EL_NCBI_API_KEY=
EL_OPENFDA_API_KEY=
EL_CONTACT_EMAIL=you@example.com
